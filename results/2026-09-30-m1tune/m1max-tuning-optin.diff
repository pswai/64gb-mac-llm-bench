+/* Opt-in experiment: DS4_METAL_M1MAX_TUNING=1 applies the M1 Max-measured
+ * resident Q2 dispatch choices on the current device as well. Unset keeps the
+ * device-name gate unchanged. Streaming, Q4/MXFP4 and M3/M5/M6 gates are not
+ * affected. Each site logs once to stderr the first time the override (not
+ * the native M1 Max gate) enables it, so runs record which paths fired. */
+static int ds4_gpu_m1max_tuning_enabled(int site) {
+    static int forced = -1;
+    static unsigned logged = 0;
+    static unsigned mask = 0x7fu;
+    static const char *names[] = {"q8_nr4_proj", "hc_down_tile", "hc_norm_reuse",
+                                  "hc_mix_reuse", "iq2_nr2_mid", "q2k_down_reuse", "q8_mtp_rows"};
+    if (ds4_gpu_device_name_contains("M1 Max")) return 1;
+    if (forced < 0) {
+        const char *e = getenv("DS4_METAL_M1MAX_TUNING");
+        forced = e && strcmp(e, "1") == 0;
+        const char *m = getenv("DS4_METAL_M1MAX_TUNING_MASK");   /* optional per-site isolation */
+        if (forced && m && m[0]) mask = (unsigned)strtoul(m, NULL, 0);
+    }
+    if (forced && !(mask & (1u << site))) return 0;
+    if (forced && site >= 0 && site < 7 && !(logged & (1u << site))) {
+        logged |= 1u << site;
+        fprintf(stderr, "ds4: DS4_METAL_M1MAX_TUNING applied: %s\n", names[site]);
+    }
+    return forced;
+}
