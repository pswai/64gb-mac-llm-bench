# Repo-driver config for the 0231312 retest: base 0aaea5a vs PR head 0231312, chunk 2048 pinned.
BASE_DIR=$HOME/Dev/ds4-bench-0aaea5a
HEAD_DIR=$HOME/Dev/ds4-pr1056-0231312
DS4_DIR=$BASE_DIR
EXPECT_COMMIT=
CONFIGS=${CONFIGS:-"base-chunk2048 head-chunk2048"}
QWEN=$HOME/Dev/ds4/gguf/Qwen3.8-Flash-Next-Q2.gguf
config_model() { echo "$QWEN"; }
config_flags() { case $1 in base-chunk2048|head-chunk2048) echo "--prefill-chunk 2048" ;; *) echo "UNKNOWN" ;; esac; }
config_ds4_dir() { case $1 in base-*) echo "$BASE_DIR" ;; head-*) echo "$HEAD_DIR" ;; esac; }
config_expect_commit() { case $1 in base-*) echo 0aaea5a238fb41a35106a551e73c8409dfb751ac ;; head-*) echo 0231312820fb0ba0e8953606976461644511bcab ;; esac; }
config_env() { echo "DS4_QWEN4_PREFILL_CHUNK=2048"; }
model_expect() { case $(basename "$1") in Qwen3.8-Flash-Next-Q2.gguf) echo "147207127040 b1b93fa69aca5f187b0fb813aca8f3ec1beb5cf8cf0bd38cf041b93e0b6ccac9" ;; esac; }
